# Docker does not honor .gitignore — keep this aligned with local junk / secrets.
target/
.git/
.github/
.devcontainer/

# Tooling / local agent state
.idea/
.vscode/
.worktrees/
.beads/
.swarm/
.mimocode/
.cline/
.opencode/
.codacy/
.kilo/
.kilocode/
.cursor/
.devin/
.cache/

# Secrets / credentials
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
**/auth.json
**/*credentials*

# Local data / caches (mirror .gitignore)
node_modules/
dist/
build/
__pycache__/
*.log
.DS_Store

# CI / analysis noise
.codacy.yml
.deepsource.toml
docs/

**/*.md
!README.md
!CHANGELOG.md
